import org.apache.jmeter.protocol.http.control.Cookie

def config = vars.getObject('athena.config')
def user = vars.getObject('athena.user')
def id = Parameters
def op = id == 'session' ? [path: config.dashboard, method:'GET'] : config.operations.find { it.id == id }
if (id != 'session') {
    def prefix = vars.getIteration() &lt;= config.warmupLoops ? 'WARMUP' : 'PERF'
    sampler.setName(prefix + ' | ' + id + ' | ' + op.name)
}
def expand = { String value -&gt; value.replaceAll(/\$\{([a-zA-Z0-9_]+)\}/) { full, key -&gt;
    def replacement = vars.get(key)
    if (replacement == null || replacement.isEmpty()) throw new IllegalStateException('Missing fixture variable: ' + key)
    java.util.regex.Matcher.quoteReplacement(replacement)
} }
def base = new URI(config.baseUrl)
def target = new URI(config.baseUrl + expand(op.path))
if (target.host != base.host || target.scheme != base.scheme || target.port != base.port) throw new IllegalStateException('Cross-origin requests are not allowed.')
sampler.setProtocol(target.scheme)
sampler.setDomain(target.host)
sampler.setPort(target.port == -1 ? (target.scheme == 'https' ? 443 : 80) : target.port)
sampler.setPath(target.rawPath + (target.rawQuery ? '?' + target.rawQuery : ''))
sampler.setMethod(op.method)
sampler.setFollowRedirects(false)
sampler.setAutoRedirects(false)
sampler.getArguments().removeAllArguments()
sampler.getHeaderManager().removeHeaderNamed('Content-Type')
sampler.getHeaderManager().removeHeaderNamed('X-CSRF-TOKEN')
sampler.getHeaderManager().removeHeaderNamed('X-Livewire')
sampler.getHeaderManager().removeHeaderNamed('Accept')
sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header('Accept', op.json || op.payload || op.component ? 'application/json' : 'text/html,application/xhtml+xml'))
if (!vars.get('athena.cookies_loaded')) {
    def state = new JsonSlurper().parse(new File(user.sessionFile))
    def manager = sampler.getCookieManager()
    state.cookies.each { c -&gt;
        def host = c.domain.replaceFirst(/^\./, '')
        if (target.host == host || target.host.endsWith('.' + host)) {
            manager.add(new Cookie(c.name, c.value, c.domain, c.path ?: '/', c.secure ?: false, 0))
        }
    }
    vars.put('athena.cookies_loaded', 'true')
}
if (op.method != 'GET') {
    def csrf = vars.get('athena.csrf')
    if (!csrf) throw new IllegalStateException('No current CSRF token. The authenticated setup request must succeed first.')
    def data
    if (op.component) {
        def snapshot = vars.getObject('athena.snapshots')[op.component]
        if (!snapshot) throw new IllegalStateException('Required Livewire snapshot missing: ' + op.component)
        data = [_token:csrf, components:[[snapshot:snapshot, updates:[:], calls:[[path:'', method:'$refresh', params:[]]]]]]
        sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header('X-Livewire','true'))
    } else {
        data = new JsonSlurper().parseText(expand(JsonOutput.toJson(user.payloads[id])))
        if (op.budgetToken) {
            if (!vars.get('budget_token')) throw new IllegalStateException('Missing current budget concurrency token.')
            data.budget_token = vars.get('budget_token')
        }
    }
    sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header('X-CSRF-TOKEN', csrf))
    sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header('Content-Type','application/json'))
    sampler.setPostBodyRaw(true)
    sampler.addNonEncodedArgument('', JsonOutput.toJson(data), '')
} else {
    sampler.setPostBodyRaw(false)
}
</stringProp></JSR223PreProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify status, session and content" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">conference-search</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
import org.jsoup.Jsoup

def config = vars.getObject('athena.config')
def id = Parameters
def op = id == 'session' ? [status:[200], session:true] : config.operations.find { it.id == id }
def fail = { String message -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(message); prev.setSuccessful(false); prev.setStopThread(true) }
try {
    if (!op.status.contains(prev.getResponseCode().isInteger() ? prev.getResponseCode().toInteger() : -1)) {
        fail('Unexpected HTTP status: ' + prev.getResponseCode() + '. Check authentication, permissions, validation and rate limits.')
        return
    }
    def headers = prev.getResponseHeaders()
    def locationLine = headers.readLines().find { it.toLowerCase().startsWith('location:') }
    if (locationLine) {
        def location = new URI(config.baseUrl).resolve(locationLine.substring(9).trim())
        def base = new URI(config.baseUrl)
        if (location.host != base.host || location.scheme != base.scheme || location.port != base.port || location.path ==~ /.*\/(login|choose-workspace|select-role)\/?$/) {
            fail('Unexpected authentication/workspace or cross-origin redirect.'); return
        }
        if (op.location &amp;&amp; !(location.path ==~ (new URI(config.baseUrl).path + op.location))) {
            fail('Redirect does not match the successful operation destination.'); return
        }
    } else if (op.location) {
        fail('Expected successful creation redirect is missing.'); return
    }
    if (op.binary) {
        if (prev.getResponseData().length == 0 || (headers =~ /(?im)^content-type:\s*text\/html/).find()) fail('Expected a nonempty document, not an HTML page.')
        return
    }
    def text = prev.getResponseDataAsString()
    if (op.json || op.component || (op.payload &amp;&amp; prev.getResponseCode() == '200')) {
        def data = new JsonSlurper().parseText(text)
        if (data instanceof Map &amp;&amp; (data.error || data.errors || data.success == false)) { fail('Application reported a JSON error.'); return }
        if (op.component &amp;&amp; (!(data.components instanceof List) || data.components.isEmpty())) { fail('Missing Livewire component response.'); return }
        (data instanceof Map ? data.components : null)?.each { c -&gt;
            def snapshot = new JsonSlurper().parseText(c.snapshot)
            vars.getObject('athena.snapshots')[snapshot.memo.name] = c.snapshot
            if (c.effects?.errors) fail('Livewire reported validation errors.')
        }
    } else if (prev.getResponseCode() == '200') {
        def document = Jsoup.parse(text)
        if (document.select('a[href$=&quot;/auth/google&quot;]').size() &gt; 0 || document.select('form[action$=&quot;/login&quot;]').size() &gt; 0) { fail('A sign-in page was returned instead of the module.'); return }
        if (op.session &amp;&amp; !text.contains(config.workspaceMarker)) { fail('The saved session did not open the expected workspace.'); return }
        if (op.session &amp;&amp; document.select('body').first()?.attr('data-active-workspace') != config.workspace) { fail('The authenticated account is using a different workspace.'); return }
        def token = document.select('meta[name=csrf-token]').first()?.attr('content')
        if (token) vars.put('athena.csrf', token)
        if (op.session &amp;&amp; !token) { fail('The authenticated response did not contain a CSRF token.'); return }
        document.getElementsByAttribute('wire:snapshot').each { element -&gt;
            def raw = element.attr('wire:snapshot')
            def snapshot = new JsonSlurper().parseText(raw)
            vars.getObject('athena.snapshots')[snapshot.memo.name] = raw
        }
        def budgetToken = document.select('input[name=budget_token]').first()?.attr('value')
        if (budgetToken) vars.put('budget_token', budgetToken)
    }
} catch (Exception ignored) {
    fail('Response structure did not match the expected operation. No response content has been saved.')
}
