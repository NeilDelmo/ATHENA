<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ATHENA deployed module benchmarks" enabled="true"><stringProp name="TestPlan.comments">Prepared HTTP/backend tests. Google sign-in must be captured first. No browser rendering, external Turnitin load, or unconfigured record submissions are implied. Load run.properties with -q before execution.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp></TestPlan><hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Independent ATHENA sessions" enabled="true"><stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Iterations" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">${__P(athena.loops,1)}</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(athena.users,1)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(athena.ramp_up,1)}</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration">${__P(athena.duration,0)}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="Per-user session cookies" enabled="true"><collectionProp name="CookieManager.cookies"/><boolProp name="CookieManager.clearEachIteration">false</boolProp></CookieManager><hashTree/><ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Pause before each request" enabled="true"><stringProp name="ConstantTimer.delay">${__P(athena.pause_ms,1000)}</stringProp></ConstantTimer><hashTree/><OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Authenticated setup once per user" enabled="true"/><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SETUP | Load local run configuration" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper

try {
    def file = new File(props.getProperty('athena.config', ''))
    if (!file.isFile()) throw new IllegalStateException('Prepare a run first and load its run.properties with -q.')
    def config = new JsonSlurper().parse(file)
    if (config.users.size() &lt; ctx.getThreadGroup().getNumThreads()) throw new IllegalStateException('One independent saved session is required per virtual user.')
    def user = config.users[ctx.getThreadNum()]
    if (config.operations.any { it.write } &amp;&amp; (!config.allowWrites || config.loops != 1 || config.durationSeconds != 0)) {
        throw new IllegalStateException('Write runs require explicit enablement, one iteration and no duration loop.')
    }
    if (config.operations.any { it.external } &amp;&amp; !config.allowExternal) throw new IllegalStateException('External requests were not enabled.')
    vars.putObject('athena.config', config)
    vars.putObject('athena.user', user)
    vars.putObject('athena.snapshots', [:])
    config.operations.each { vars.put('enabled_' + it.id, 'true') }
    vars.put('run_id', config.runId)
    vars.put('user_index', String.valueOf(ctx.getThreadNum() + 1))
    user.records.each { k,v -&gt; vars.put(k, String.valueOf(v)) }
    SampleResult.setResponseCode('200')
    SampleResult.setResponseMessage('Prepared configuration loaded; no server request')
    SampleResult.setSuccessful(true)
} catch (Exception ignored) {
    SampleResult.setResponseCode('CONFIG_ERROR')
    SampleResult.setResponseMessage('Configuration/session setup failed. Check the prepared run and account count.')
    SampleResult.setSuccessful(false)
    SampleResult.setStopThread(true)
}
</stringProp></JSR223Sampler><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="SETUP | Verify authenticated workspace" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">127.0.0.1</stringProp><stringProp name="HTTPSampler.port">1</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/configuration-required</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">120000</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Request headers" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="User-Agent" elementType="Header"><stringProp name="Header.name">User-Agent</stringProp><stringProp name="Header.value">ATHENA-Capstone-JMeter</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare request and session" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">session</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import org.apache.jmeter.protocol.http.control.Cookie

def config = vars.getObject('athena.config')
def user = vars.getObject('athena.user')
def id = Parameters
def op = id == 'session' ? [path: config.dashboard, method:'GET'] : config.operations.find { it.id == id }
if (id != 'session') {
    def prefix = vars.getIteration() &lt;= config.warmupLoops ? 'WARMUP' : 'PERF'
    sampler.setName(prefix + ' | ' + id + ' | ' + op.name)
}
def expand = { String value -&gt; value.replaceAll(/\$\{([a-zA-Z0-9_]+)\}/) { full, key -&gt;
    def replacement = vars.get(key)
    if (replacement == null || replacement.isEmpty()) throw new IllegalStateException('Missing fixture variable: ' + key)
    java.util.regex.Matcher.quoteReplacement(replacement)
} }
def base = new URI(config.baseUrl)
def target = new URI(config.baseUrl + expand(op.path))
if (target.host != base.host || target.scheme != base.scheme || target.port != base.port) throw new IllegalStateException('Cross-origin requests are not allowed.')
sampler.setProtocol(target.scheme)
sampler.setDomain(target.host)
sampler.setPort(target.port == -1 ? (target.scheme == 'https' ? 443 : 80) : target.port)
sampler.setPath(target.rawPath + (target.rawQuery ? '?' + target.rawQuery : ''))
sampler.setMethod(op.method)
sampler.setFollowRedirects(false)
sampler.setAutoRedirects(false)
sampler.getArguments().removeAllArguments()
sampler.getHeaderManager().removeHeaderNamed('Content-Type')
sampler.getHeaderManager().removeHeaderNamed('X-CSRF-TOKEN')
sampler.getHeaderManager().removeHeaderNamed('X-Livewire')
sampler.getHeaderManager().removeHeaderNamed('Accept')
sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header('Accept', op.json || op.payload || op.component ? 'application/json' : 'text/html,application/xhtml+xml'))
if (!vars.get('athena.cookies_loaded')) {
    def state = new JsonSlurper().parse(new File(user.sessionFile))
    def manager = sampler.getCookieManager()
    state.cookies.each { c -&gt;
        def host = c.domain.replaceFirst(/^\./, '')
        if (target.host == host || target.host.endsWith('.' + host)) {
            manager.add(new Cookie(c.name, c.value, c.domain, c.path ?: '/', c.secure ?: false, 0))
        }
    }
    vars.put('athena.cookies_loaded', 'true')
}
if (op.method != 'GET') {
    def csrf = vars.get('athena.csrf')
    if (!csrf) throw new IllegalStateException('No current CSRF token. The authenticated setup request must succeed first.')
    def data
    if (op.component) {
        def snapshot = vars.getObject('athena.snapshots')[op.component]
        if (!snapshot) throw new IllegalStateException('Required Livewire snapshot missing: ' + op.component)
        data = [_token:csrf, components:[[snapshot:snapshot, updates:[:], calls:[[path:'', method:'$refresh', params:[]]]]]]
        sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header('X-Livewire','true'))
    } else {
        data = new JsonSlurper().parseText(expand(JsonOutput.toJson(user.payloads[id])))
        if (op.budgetToken) {
            if (!vars.get('budget_token')) throw new IllegalStateException('Missing current budget concurrency token.')
            data.budget_token = vars.get('budget_token')
        }
    }
    sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header('X-CSRF-TOKEN', csrf))
    sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header('Content-Type','application/json'))
    sampler.setPostBodyRaw(true)
    sampler.addNonEncodedArgument('', JsonOutput.toJson(data), '')
} else {
    sampler.setPostBodyRaw(false)
}
</stringProp></JSR223PreProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify status, session and content" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">session</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
import org.jsoup.Jsoup

def config = vars.getObject('athena.config')
def id = Parameters
def op = id == 'session' ? [status:[200], session:true] : config.operations.find { it.id == id }
def fail = { String message -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(message); prev.setSuccessful(false); prev.setStopThread(true) }
try {
    if (!op.status.contains(prev.getResponseCode().isInteger() ? prev.getResponseCode().toInteger() : -1)) {
        fail('Unexpected HTTP status: ' + prev.getResponseCode() + '. Check authentication, permissions, validation and rate limits.')
        return
    }
    def headers = prev.getResponseHeaders()
    def locationLine = headers.readLines().find { it.toLowerCase().startsWith('location:') }
    if (locationLine) {
        def location = new URI(config.baseUrl).resolve(locationLine.substring(9).trim())
        def base = new URI(config.baseUrl)
        if (location.host != base.host || location.scheme != base.scheme || location.port != base.port || location.path ==~ /.*\/(login|choose-workspace|select-role)\/?$/) {
            fail('Unexpected authentication/workspace or cross-origin redirect.'); return
        }
        if (op.location &amp;&amp; !(location.path ==~ (new URI(config.baseUrl).path + op.location))) {
            fail('Redirect does not match the successful operation destination.'); return
        }
    } else if (op.location) {
        fail('Expected successful creation redirect is missing.'); return
    }
    if (op.binary) {
        if (prev.getResponseData().length == 0 || (headers =~ /(?im)^content-type:\s*text\/html/).find()) fail('Expected a nonempty document, not an HTML page.')
        return
    }
    def text = prev.getResponseDataAsString()
    if (op.json || op.component || (op.payload &amp;&amp; prev.getResponseCode() == '200')) {
        def data = new JsonSlurper().parseText(text)
        if (data instanceof Map &amp;&amp; (data.error || data.errors || data.success == false)) { fail('Application reported a JSON error.'); return }
        if (op.component &amp;&amp; (!(data.components instanceof List) || data.components.isEmpty())) { fail('Missing Livewire component response.'); return }
        (data instanceof Map ? data.components : null)?.each { c -&gt;
            def snapshot = new JsonSlurper().parseText(c.snapshot)
            vars.getObject('athena.snapshots')[snapshot.memo.name] = c.snapshot
            if (c.effects?.errors) fail('Livewire reported validation errors.')
        }
    } else if (prev.getResponseCode() == '200') {
        def document = Jsoup.parse(text)
        if (document.select('a[href$=&quot;/auth/google&quot;]').size() &gt; 0 || document.select('form[action$=&quot;/login&quot;]').size() &gt; 0) { fail('A sign-in page was returned instead of the module.'); return }
        if (op.session &amp;&amp; !text.contains(config.workspaceMarker)) { fail('The saved session did not open the expected workspace.'); return }
        if (op.session &amp;&amp; document.select('body').first()?.attr('data-active-workspace') != config.workspace) { fail('The authenticated account is using a different workspace.'); return }
        def token = document.select('meta[name=csrf-token]').first()?.attr('content')
        if (token) vars.put('athena.csrf', token)
        if (op.session &amp;&amp; !token) { fail('The authenticated response did not contain a CSRF token.'); return }
        document.getElementsByAttribute('wire:snapshot').each { element -&gt;
            def raw = element.attr('wire:snapshot')
            def snapshot = new JsonSlurper().parseText(raw)
            vars.getObject('athena.snapshots')[snapshot.memo.name] = raw
        }
        def budgetToken = document.select('input[name=budget_token]').first()?.attr('value')
        if (budgetToken) vars.put('budget_token', budgetToken)
    }
} catch (Exception ignored) {
    fail('Response structure did not match the expected operation. No response content has been saved.')
}
</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="01 Dashboard and analytics / head-dashboard" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get(&quot;enabled_head-dashboard&quot;) == &quot;true&quot;)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PERF | head-dashboard | Head dashboard HTML" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">127.0.0.1</stringProp><stringProp name="HTTPSampler.port">1</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/configuration-required</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">120000</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Request headers" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="User-Agent" elementType="Header"><stringProp name="Header.name">User-Agent</stringProp><stringProp name="Header.value">ATHENA-Capstone-JMeter</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare request and session" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">head-dashboard</stringProp>